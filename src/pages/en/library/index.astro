---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButton from '../../../components/ShareButton.astro';
import { ui } from '../../../i18n/ui';
const t = ui.en;
import StarRating from '../../../components/StarRating.astro';
import libraryData from '../../../data/library.json';

const { items } = libraryData;
const themes = [...new Set(items.map((item) => item.theme))].sort();

const MONTH_NAMES = t.monthNames;

function monthId(dateStr: string): string {
  const [year, month] = dateStr.split('-').map(Number);
  const name = MONTH_NAMES[month - 1]
    .normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  return `${year}-${name}`;
}

function monthLabel(dateStr: string): string {
  const [year, month] = dateStr.split('-').map(Number);
  return `${year} - ${MONTH_NAMES[month - 1]}`;
}

type Item = typeof items[0];
type ItemGroup = { id: string; label: string; items: Item[] };

const sortedItems = [...items].sort(
  (a, b) => new Date(b.addedAt).valueOf() - new Date(a.addedAt).valueOf()
);

const groups: ItemGroup[] = [];
for (const item of sortedItems) {
  const id = monthId(item.addedAt);
  const label = monthLabel(item.addedAt);
  const g = groups.find(g => g.id === id);
  if (g) g.items.push(item);
  else groups.push({ id, label, items: [item] });
}

const themeColors: Record<string, string> = {
  'IA Skills': 'bg-apple-blue/10 text-apple-blue dark:bg-apple-blue/20 dark:text-apple-blue-dark',
  'SDD':       'bg-[#34c759]/10 text-[#1a7a33] dark:bg-[#34c759]/20 dark:text-[#34c759]',
  'Harness':   'bg-[#ff9500]/10 text-[#8a5100] dark:bg-[#ff9500]/20 dark:text-[#ff9500]',
};

function themeClass(theme: string): string {
  return themeColors[theme] ?? 'bg-apple-parchment text-apple-ink-48 dark:bg-[#2c2c2e] dark:text-[#98989d]';
}
---

<BaseLayout title={t.library.title} description={t.library.description} lang="en" altHref="/library/">
  <div class="mb-12">
    <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7]">{t.library.title}</h1>
    <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-2">{t.library.description}</p>
  </div>

  <div class="flex flex-wrap gap-2 mb-10">
    <button
      class="filter-btn px-4 py-[11px] text-apple-caption rounded-full border border-apple-blue bg-apple-blue text-white transition-all"
      data-theme="all"
    >
      {t.library.allThemes}
    </button>
    {themes.map((theme) => (
      <button
        class="filter-btn px-4 py-[11px] text-apple-caption rounded-full border border-apple-hairline dark:border-[#3a3a3c] text-apple-ink dark:text-[#f5f5f7] hover:border-apple-blue hover:text-apple-blue transition-all"
        data-theme={theme}
      >
        {theme}
      </button>
    ))}
  </div>

  <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-16">
    <!-- Main content -->
    <div>
      {groups.map((group) => (
        <section id={group.id} data-month class="mb-14">
          <h2 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] mb-6 pb-3 border-b border-apple-hairline dark:border-[#3a3a3c]">
            {group.label}
          </h2>
          <ul class="flex flex-col gap-4">
            {group.items.map((item) => (
              <li
                class="library-item rounded-apple-lg border border-apple-hairline dark:border-[#3a3a3c] dark:bg-[#2c2c2e] p-6"
                data-theme={item.theme}
              >
                <div class="flex items-start justify-between gap-6">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-2 flex-wrap">
                      <span class={`text-apple-nav font-medium px-2 py-0.5 rounded-full uppercase tracking-wide ${themeClass(item.theme)}`}>
                        {item.theme}
                      </span>
                    </div>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[17px] font-semibold leading-[1.24] tracking-[-0.374px] text-apple-ink dark:text-[#f5f5f7] hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors block"
                    >
                      {item.title_en ?? item.title}
                    </a>
                    <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-1">{item.description_en ?? item.description}</p>
                    {item.personalNote && (
                      <p class="text-apple-caption text-apple-ink-48 dark:text-[#98989d] mt-3 italic border-l-2 border-apple-hairline dark:border-[#3a3a3c] pl-3">
                        {item.personalNote}
                      </p>
                    )}
                  </div>
                  <div class="flex flex-col items-end gap-3 shrink-0">
                    <ShareButton url={item.url} title={item.title_en ?? item.title} />
                    <StarRating itemId={item.id} />
                  </div>
                </div>
                <p class="text-apple-caption text-apple-ink-48 dark:text-[#6e6e73] mt-4">
                  {t.library.addedAt} {new Date(item.addedAt).toLocaleDateString(t.dateLocale)}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Sidebar -->
    {groups.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <p class="text-apple-caption font-semibold text-apple-ink-48 dark:text-[#6e6e73] mb-3 uppercase tracking-wide">
            {t.library.sidebarTitle}
          </p>
          <nav>
            <ul class="flex flex-col gap-1">
              {groups.map((group) => (
                <li>
                  <a
                    href={`#${group.id}`}
                    data-month-link={group.id}
                    class="text-apple-caption text-apple-ink-48 dark:text-[#6e6e73] hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors block py-0.5"
                  >
                    {group.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  // --- Filter ---
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const libraryItems = document.querySelectorAll<HTMLLIElement>('.library-item');

  function syncMonthVisibility() {
    document.querySelectorAll<HTMLElement>('section[data-month]').forEach(section => {
      const hasVisible = Array.from(section.querySelectorAll<HTMLElement>('.library-item'))
        .some(item => item.style.display !== 'none');
      section.style.display = hasVisible ? '' : 'none';
      const navLi = document.querySelector<HTMLElement>(`[data-month-link="${section.id}"]`)
        ?.closest('li') as HTMLElement | null;
      if (navLi) navLi.style.display = hasVisible ? '' : 'none';
    });
    updateActiveLink();
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-apple-blue', 'text-white', 'border-apple-blue');
        b.classList.add('border-apple-hairline', 'text-apple-ink');
      });
      btn.classList.add('bg-apple-blue', 'text-white', 'border-apple-blue');
      btn.classList.remove('border-apple-hairline', 'text-apple-ink');

      const theme = btn.dataset.theme;
      libraryItems.forEach((item) => {
        item.style.display =
          theme === 'all' || item.dataset.theme === theme ? '' : 'none';
      });
      syncMonthVisibility();
    });
  });

  // --- Scroll-spy ---
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-month]'));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-month-link]'));

  function updateActiveLink() {
    if (!navLinks.length) return;
    const visibleSections = sections.filter(s => s.style.display !== 'none');
    if (!visibleSections.length) return;
    let currentId = visibleSections[0].id;
    for (const section of visibleSections) {
      if (section.getBoundingClientRect().top <= 120) {
        currentId = section.id;
      }
    }
    navLinks.forEach(link => {
      const active = link.dataset.monthLink === currentId;
      link.classList.toggle('text-apple-blue', active);
      link.classList.toggle('dark:text-apple-blue-dark', active);
      link.classList.toggle('font-semibold', active);
      link.classList.toggle('text-apple-ink-48', !active);
      link.classList.toggle('dark:text-[#6e6e73]', !active);
    });
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
</script>
