---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProgressBar from '../../../components/ProgressBar.astro';
import { ui } from '../../../i18n/ui';
const t = ui.en;

export const prerender = true;

const tracks = (await getCollection('tracks-en')).sort((a, b) =>
  a.slug.localeCompare(b.slug)
);

const allModules = await getCollection('track-modules-en');
const resourceCounts: Record<string, number> = {};
for (const mod of allModules) {
  const trackSlug = mod.id.split('/')[0];
  const count = (mod.data.officialResources as any[] | undefined)?.length ?? 0;
  resourceCounts[trackSlug] = (resourceCounts[trackSlug] ?? 0) + count;
}

const categoryColors: Record<string, string> = {
  'certification': 'bg-apple-blue/10 text-apple-blue dark:bg-apple-blue/20 dark:text-apple-blue-dark',
  'certificação':  'bg-apple-blue/10 text-apple-blue dark:bg-apple-blue/20 dark:text-apple-blue-dark',
  'engineering':   'bg-[#34c759]/10 text-[#1a7a33] dark:bg-[#34c759]/20 dark:text-[#34c759]',
  'engenharia':    'bg-[#34c759]/10 text-[#1a7a33] dark:bg-[#34c759]/20 dark:text-[#34c759]',
  'product':       'bg-[#ff9500]/10 text-[#8a5100] dark:bg-[#ff9500]/20 dark:text-[#ff9500]',
  'produto':       'bg-[#ff9500]/10 text-[#8a5100] dark:bg-[#ff9500]/20 dark:text-[#ff9500]',
};

const tracksData = tracks.map(tr => ({
  slug:           tr.slug,
  title:          tr.data.title,
  description:    tr.data.description,
  category:       tr.data.category,
  source:         tr.data.source,
  estimatedHours: tr.data.estimatedHours,
  resourceCount:  resourceCounts[tr.slug] ?? 0,
  href:           `/en/tracks/${tr.slug}`,
  tagClass:       categoryColors[tr.data.category] ?? 'bg-apple-parchment text-apple-ink-48 dark:bg-[#2c2c2e] dark:text-[#98989d]',
}));
---

<BaseLayout title="Tracks — Vinicius Tirabassi" description="Curated learning tracks" lang="en" altHref="/trilhas/">
  <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7] mb-12">Tracks</h1>

  {tracks.length === 0 && (
    <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d]">No tracks available yet.</p>
  )}

  {tracksData.length > 0 && (
    <div id="tracks-listing" class="flex flex-col gap-4">
      {tracksData.map(tr => (
        <a
          href={tr.href}
          data-track-card
          data-slug={tr.slug}
          data-resource-count={tr.resourceCount}
          class="block border border-apple-hairline dark:border-[#3a3a3c] rounded-apple-lg p-6 hover:border-apple-blue dark:hover:border-apple-blue-dark transition-colors group"
        >
          <div class="flex items-start justify-between gap-4 mb-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2 flex-wrap">
                <span class={`text-apple-nav font-medium px-2 py-0.5 rounded-full uppercase tracking-wide ${tr.tagClass}`}>
                  {tr.category}
                </span>
                <span class="text-apple-nav font-medium px-2 py-0.5 rounded-full bg-apple-parchment text-apple-ink-48 dark:bg-[#2c2c2e] dark:text-[#98989d]">
                  {tr.source}
                </span>
                <span data-card-status class="text-apple-nav text-apple-ink-48 dark:text-[#98989d] hidden">
                  IN PROGRESS
                </span>
              </div>
              <h2 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors mb-1">
                {tr.title}
              </h2>
              <p class="text-apple-caption text-apple-ink-48 dark:text-[#98989d]">
                {tr.source} · ~{tr.estimatedHours} {t.tracks.hours} ·
                <span data-card-progress-text>{t.tracks.notStarted}</span>
              </p>
            </div>
            <span data-card-pct class="text-apple-tagline font-semibold text-apple-blue dark:text-apple-blue-dark shrink-0 hidden">
              0%
            </span>
          </div>
          <ProgressBar percent={0} id={`bar-${tr.slug}`} />
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<script>
  import { getCompletedResources, calcProgressPercent } from '../../../lib/track-progress';

  document.querySelectorAll<HTMLElement>('[data-track-card]').forEach(card => {
    const slug = card.dataset.slug!;
    const resourceCount = parseInt(card.dataset.resourceCount ?? '0');
    const completed = getCompletedResources(slug).length;
    if (completed <= 0) return;

    const pct = calcProgressPercent(completed, resourceCount);
    const progressText = card.querySelector('[data-card-progress-text]');
    const progressBar  = document.getElementById(`bar-${slug}`);
    const progressPct  = card.querySelector('[data-card-pct]');
    const statusBadge  = card.querySelector('[data-card-status]');

    if (progressText) progressText.textContent = `${completed} of ${resourceCount} resources`;
    if (progressBar)  progressBar.style.width = `${pct}%`;
    if (progressPct)  { progressPct.textContent = `${pct}%`; progressPct.classList.remove('hidden'); }
    if (statusBadge)  statusBadge.classList.remove('hidden');
  });
</script>
