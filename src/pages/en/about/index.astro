---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Vinicius Tirabassi"
  description="Software Engineering Manager @ XP Inc. | Leading squads on mission-critical platforms"
  lang="en"
  altHref="/sobre/"
>
  <div class="max-w-2xl mx-auto flex flex-col gap-12">

    <!-- Header -->
    <div class="flex flex-col items-center text-center gap-6">
      <img src="/avatar.jpg" alt="Vinicius Tirabassi" class="w-24 h-24 rounded-full object-cover" />
      <div class="flex flex-col gap-2">
        <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7]">Vinicius Tirabassi</h1>
        <p class="text-[22px] leading-[1.2] font-normal text-apple-ink-48 dark:text-[#98989d]">
          Software Engineering Manager · XP Inc.
        </p>
      </div>
      <div class="flex gap-3 flex-wrap justify-center">
        <a href="https://github.com/vtirabassi" target="_blank" rel="noopener noreferrer"
           class="bg-apple-blue text-white text-apple-body rounded-full px-[22px] py-[11px] transition-transform active:scale-95">GitHub</a>
        <a href="https://www.linkedin.com/in/viniciustirabassi/" target="_blank" rel="noopener noreferrer"
           class="border border-apple-blue text-apple-blue text-apple-body rounded-full px-[22px] py-[11px] transition-transform active:scale-95">LinkedIn</a>
        <a href="https://medium.com/@viniciustirabassi" target="_blank" rel="noopener noreferrer"
           class="border border-apple-hairline dark:border-[#3a3a3c] text-apple-ink-48 dark:text-[#98989d] text-apple-body rounded-full px-[22px] py-[11px] transition-transform active:scale-95">Medium</a>
      </div>
    </div>

    <!-- Bio -->
    <div class="flex flex-col gap-4 text-apple-body text-apple-ink dark:text-[#f5f5f7]">
      <p>
        I lead engineering squads on mission-critical platforms at XP Inc. —
        <strong>Core Banking</strong> and <strong>Core Investments</strong>, responsible for cash-in and cash-out flows
        across the entire operation. I directly manage 12 engineers across 2 squads.
      </p>
      <p>
        I believe engineering leadership is not about writing less code, but about
        <strong>amplifying the team's impact</strong>. My job is to build environments where engineers make good
        technical decisions, have clarity of purpose, and deliver predictably — even in high-complexity,
        zero-tolerance-for-failure contexts.
      </p>
      <p>
        My background combines a strong technical foundation with management: I started as an engineer building
        XP's Business Digital Account from scratch (PIX, TED, transfers, payments, multi-channel) and now lead
        the teams responsible for that and other core platforms.
      </p>
    </div>

    <!-- What drives my work -->
    <div class="flex flex-col gap-4">
      <h2 class="text-[22px] font-semibold text-apple-ink dark:text-[#f5f5f7] leading-snug">What drives my work</h2>
      <ul class="flex flex-col gap-3 text-apple-body text-apple-ink dark:text-[#f5f5f7]">
        <li class="flex gap-3">
          <span class="text-apple-blue dark:text-apple-blue-dark mt-[2px]">→</span>
          <span>Engineering as a means, business as the end — every technical investment must translate into value for the customer and the operation</span>
        </li>
        <li class="flex gap-3">
          <span class="text-apple-blue dark:text-apple-blue-dark mt-[2px]">→</span>
          <span>Leadership based on trust, autonomy, and context — not control</span>
        </li>
        <li class="flex gap-3">
          <span class="text-apple-blue dark:text-apple-blue-dark mt-[2px]">→</span>
          <span>Feedback culture, high performance, and people development</span>
        </li>
        <li class="flex gap-3">
          <span class="text-apple-blue dark:text-apple-blue-dark mt-[2px]">→</span>
          <span>Architectural decisions connected to strategy — scalability, observability, cost, time-to-market</span>
        </li>
      </ul>
    </div>

    <!-- Stack -->
    <div class="flex flex-col gap-4">
      <h2 class="text-[22px] font-semibold text-apple-ink dark:text-[#f5f5f7] leading-snug">Stack</h2>
      <div class="flex flex-wrap gap-2">
        {['.NET', 'Azure', 'Kafka', 'Microservices', 'Event-Driven', 'Datadog', 'Grafana', 'Dynatrace', 'CI/CD', 'Azure DevOps', 'GitHub Copilot', 'Claude', 'Codex'].map(tag => (
          <span class="text-apple-caption text-apple-ink-80 dark:text-[#98989d] bg-apple-parchment dark:bg-[#2c2c2e] border border-apple-hairline dark:border-[#3a3a3c] rounded-full px-3 py-1">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Teaching -->
    <div class="border-t border-apple-hairline dark:border-[#3a3a3c] pt-8 text-apple-body text-apple-ink-48 dark:text-[#98989d]">
      For over 3 years I have worked as a <strong class="text-apple-ink dark:text-[#f5f5f7]">University Tutor at FIAP</strong>, in the
      Systems Analysis and Development program. MBA from USP/Esalq.
    </div>

  </div>
</BaseLayout>
