---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../i18n/ui';
const t = ui.en;

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog-en');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { slug } = Astro.params;
const post = Astro.props.post;

if (!post) {
  const ptPost = await getEntry('blog', slug!);
  if (ptPost) return Astro.redirect(`/blog/${slug}`);
  return Astro.redirect('/en/blog/');
}

const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description} lang="en" altHref={`/blog/${post.slug}`}>
  <article>
    <header class="mb-8">
      <p class="text-apple-caption text-apple-ink-48 dark:text-[#98989d] mb-2">
        {post.data.date.toLocaleDateString(t.dateLocale, { day: '2-digit', month: 'long', year: 'numeric' })}
      </p>
      <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7] leading-tight">{post.data.title}</h1>
      <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-3">{post.data.description}</p>
      <div class="flex gap-2 mt-4 flex-wrap">
        {post.data.tags.map((tag) => (
          <span class="text-apple-caption bg-apple-parchment dark:bg-[#2c2c2e] text-apple-ink-48 dark:text-[#98989d] px-3 py-1 rounded-full border border-apple-divider dark:border-[#3a3a3c]">{tag}</span>
        ))}
      </div>
    </header>
    <div class="prose prose-apple dark:prose-invert max-w-none">
      <Content />
    </div>
    <div class="mt-12 pt-8 border-t border-apple-hairline dark:border-[#3a3a3c]">
      <a href="/en/" class="text-apple-body text-apple-blue dark:text-apple-blue-dark hover:opacity-70 transition-opacity">
        {t.post.backToHome}
      </a>
    </div>
  </article>
</BaseLayout>
