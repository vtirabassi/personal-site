---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ui } from '../../../i18n/ui';
const t = ui.en;

export const prerender = true;

function monthId(date: Date): string {
  const name = (t.monthNames[date.getUTCMonth()] as string)
    .normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  return `${date.getUTCFullYear()}-${name}`;
}

function monthLabel(date: Date): string {
  return `${date.getUTCFullYear()} - ${t.monthNames[date.getUTCMonth()]}`;
}

const allPosts = (await getCollection('blog-en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

type PostGroup = { id: string; label: string; posts: typeof allPosts };
const groups: PostGroup[] = [];
for (const post of allPosts) {
  const id = monthId(post.data.date);
  const label = monthLabel(post.data.date);
  const g = groups.find(g => g.id === id);
  if (g) g.posts.push(post);
  else groups.push({ id, label, posts: [post] });
}
---

<BaseLayout title={t.blog.title} description={t.blog.description} lang="en" altHref="/blog/">
  <div class="mb-12">
    <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7]">{t.blog.title}</h1>
    <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-2">{t.blog.description}</p>
  </div>

  <div class="lg:grid lg:grid-cols-[1fr_200px] lg:gap-16">
    <div>
      {groups.map((group) => (
        <section id={group.id} data-month class="mb-14">
          <h2 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] mb-6 pb-3 border-b border-apple-hairline dark:border-[#3a3a3c]">
            {group.label}
          </h2>
          <ul class="flex flex-col gap-8">
            {group.posts.map((post) => (
              <li>
                <a href={`/en/blog/${post.slug}`} class="group block">
                  <p class="text-apple-caption text-apple-ink-48 dark:text-[#6e6e73] mb-1">
                    {post.data.date.toLocaleDateString(t.dateLocale, { day: '2-digit', month: 'long', year: 'numeric' })}
                  </p>
                  <h2 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-1">{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    {groups.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <p class="text-apple-caption font-semibold text-apple-ink-48 dark:text-[#6e6e73] mb-3 uppercase tracking-wide">
            {t.blog.sidebarTitle}
          </p>
          <nav>
            <ul class="flex flex-col gap-1">
              {groups.map((group) => (
                <li>
                  <a href={`#${group.id}`} data-month-link={group.id}
                     class="text-apple-caption text-apple-ink-48 dark:text-[#6e6e73] hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors block py-0.5">
                    {group.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
