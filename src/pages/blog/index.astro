---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Blog" description="Artigos e reflexões">
  <h1 class="text-apple-display font-semibold text-apple-ink mb-12">Blog</h1>

  {posts.length === 0 && (
    <p class="text-apple-body text-apple-ink-48">Nenhum artigo publicado ainda.</p>
  )}

  <ul class="flex flex-col gap-8">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.slug}`} class="group block">
          <p class="text-apple-caption text-apple-ink-48 mb-1">
            {post.data.date.toLocaleDateString('pt-BR', {
              day: '2-digit',
              month: 'long',
              year: 'numeric',
            })}
          </p>
          <h2 class="text-apple-tagline font-semibold text-apple-ink group-hover:text-apple-blue transition-colors">
            {post.data.title}
          </h2>
          <p class="text-apple-body text-apple-ink-48 mt-1">{post.data.description}</p>
          <div class="flex gap-2 mt-2 flex-wrap">
            {post.data.tags.map((tag) => (
              <span class="text-apple-caption bg-apple-parchment text-apple-ink-48 px-3 py-1 rounded-full border border-apple-divider">{tag}</span>
            ))}
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
