---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/ui';
const t = ui.pt;

export const prerender = true;

const MONTH_NAMES = t.monthNames;

function monthId(date: Date): string {
  const name = MONTH_NAMES[date.getUTCMonth()]
    .normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  return `${date.getUTCFullYear()}-${name}`;
}

function monthLabel(date: Date): string {
  return `${date.getUTCFullYear()} - ${MONTH_NAMES[date.getUTCMonth()]}`;
}

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

type PostGroup = { id: string; label: string; posts: typeof allPosts };
const groups: PostGroup[] = [];
for (const post of allPosts) {
  const id = monthId(post.data.date);
  const label = monthLabel(post.data.date);
  const g = groups.find(g => g.id === id);
  if (g) g.posts.push(post);
  else groups.push({ id, label, posts: [post] });
}
---

<BaseLayout title={t.blog.title} description={t.blog.description} lang="pt" altHref="/en/blog/">
  <h1 class="text-apple-display font-semibold text-apple-ink dark:text-[#f5f5f7] mb-12">Blog</h1>

  {groups.length === 0 && (
    <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d]">Nenhum artigo publicado ainda.</p>
  )}

  <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-16">
    <!-- Main content -->
    <div>
      {groups.map((group) => (
        <section id={group.id} data-month class="mb-14">
          <h2 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] mb-6 pb-3 border-b border-apple-hairline dark:border-[#3a3a3c]">
            {group.label}
          </h2>
          <ul class="flex flex-col gap-8">
            {group.posts.map((post) => (
              <li>
                <a href={`/blog/${post.slug}`} class="group block">
                  <h3 class="text-apple-tagline font-semibold text-apple-ink dark:text-[#f5f5f7] group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-apple-body text-apple-ink-48 dark:text-[#98989d] mt-1">{post.data.description}</p>
                  <div class="flex gap-2 mt-2 flex-wrap">
                    {post.data.tags.map((tag) => (
                      <span class="text-apple-caption bg-apple-parchment dark:bg-[#2c2c2e] text-apple-ink-48 dark:text-[#98989d] px-3 py-1 rounded-full border border-apple-divider dark:border-[#3a3a3c]">{tag}</span>
                    ))}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Sidebar -->
    {groups.length > 0 && (
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <p class="text-apple-caption font-semibold text-apple-ink-48 dark:text-[#6e6e73] mb-3 uppercase tracking-wide">
            {t.blog.sidebarTitle}
          </p>
          <nav>
            <ul class="flex flex-col gap-1">
              {groups.map((group) => (
                <li>
                  <a
                    href={`#${group.id}`}
                    data-month-link={group.id}
                    class="text-apple-caption text-apple-ink-48 dark:text-[#6e6e73] hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors block py-0.5"
                  >
                    {group.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-month]'));
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-month-link]'));

  function updateActiveLink() {
    if (!sections.length || !navLinks.length) return;
    let currentId = sections[0].id;
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= 120) {
        currentId = section.id;
      }
    }
    navLinks.forEach(link => {
      const active = link.dataset.monthLink === currentId;
      link.classList.toggle('text-apple-blue', active);
      link.classList.toggle('dark:text-apple-blue-dark', active);
      link.classList.toggle('font-semibold', active);
      link.classList.toggle('text-apple-ink-48', !active);
      link.classList.toggle('dark:text-[#6e6e73]', !active);
    });
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
</script>
