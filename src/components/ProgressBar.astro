---
interface Props {
  percent: number;
  id?: string;
  class?: string;
}
const { percent, id, class: cls = '' } = Astro.props;
const clamped = Math.min(100, Math.max(0, percent));
---
<div class={`bg-apple-divider dark:bg-[#3a3a3c] rounded-full h-1 overflow-hidden ${cls}`}>
  <div
    id={id}
    class="bg-apple-blue h-full rounded-full transition-all duration-300"
    style={`width: ${clamped}%`}
  />
</div>
